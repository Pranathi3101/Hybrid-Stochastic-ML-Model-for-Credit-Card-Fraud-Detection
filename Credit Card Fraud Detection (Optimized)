    "# =========================================================\n",
    "# CELL 5: TRAIN GAUSSIAN HMM ON NORMAL SAMPLES ONLY\n",
    "# =========================================================\n",
    "print(\"--- Training HMM on Normal Behavior Baseline ---\")\n",
    "\n",
    "# Sort training data by time to preserve temporal order\n",
    "train_time_order = X_train.index  # original df index carries time ordering\n",
    "X_train_normal_idx = y_train[y_train == 0].index\n",
    "\n",
    "# Get normal training samples in time order\n",
    "X_train_normal = X_train_scaled[y_train.values == 0]\n",
    "\n",
    "# Build sequences: group consecutive normal transactions into windows\n",
    "# These are genuine temporal neighbours — not random groupings\n",
    "WINDOW_SIZE = 6\n",
    "sequences = []\n",
    "lengths = []\n",
    "\n",
    "for i in range(0, len(X_train_normal) - WINDOW_SIZE + 1, WINDOW_SIZE):\n",
    "    window = X_train_normal[i:i + WINDOW_SIZE]\n",
    "    sequences.append(window)\n",
    "    lengths.append(WINDOW_SIZE)\n",
    "\n",
    "# Handle leftover rows that don't fill a full window (min length 2 for transitions)\n",
    "tail = X_train_normal[len(sequences) * WINDOW_SIZE:]\n",
    "if len(tail) >= 2:\n",
    "    sequences.append(tail)\n",
    "    lengths.append(len(tail))\n",
    "\n",
    "X_seq_concat = np.vstack(sequences)\n",
    "\n",
    "# Fit HMM on concatenated sequences with their lengths\n",
    "n_components = 4\n",
    "hmm_model = hmm.GaussianHMM(\n",
    "    n_components=n_components,\n",
    "    covariance_type=\"diag\",\n",
    "    n_iter=100,\n",
    "    random_state=42\n",
    ")\n",
    "hmm_model.fit(X_seq_concat, lengths)\n",
    "\n",
    "print(f\"HMM trained with {n_components} hidden states on {len(sequences)} sequences.\")\n",
    "print(f\"Each sequence = up to {WINDOW_SIZE} time-adjacent transactions.\")\n",
    "print(f\"Transition matrix A learned from {sum(lengths) - len(lengths)} genuine t -> t+1 steps.\")"
   ]
