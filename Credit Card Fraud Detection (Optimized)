    "# =========================================================\n",
    "# CELL 6: SEQUENTIAL LOG-LIKELIHOOD SCORE GENERATION\n",
    "# =========================================================\n",
    "print(\"--- Generating Sequential HMM Features via Time-Adjacent Windows ---\")\n",
    "\n",
    "def score_with_temporal_windows(X_arr, hmm_model, window_size=WINDOW_SIZE):\n",
    "    \"\"\"\n",
    "    Score each transaction based on itself and up to (window_size - 1)\n",
    "    preceding time-adjacent transactions.\n",
    "\n",
    "    For transaction at position i:\n",
    "      - i = 0          : length-1 fallback, no prior context\n",
    "      - 0 < i < window : growing window [0..i], length = i+1\n",
    "      - i >= window     : full window [i-window+1..i], length = window_size\n",
    "\n",
    "    This means the transition matrix A is exercised for every transaction\n",
    "    except the very first, giving a genuine sequential anomaly signal.\n",
    "    The score is normalised by sequence length (per-step log-likelihood)\n",
    "    so shorter and longer windows are on the same scale.\n",
    "    \"\"\"\n",
    "    scores = np.zeros(len(X_arr))\n",
    "\n",
    "    for i in range(len(X_arr)):\n",
    "        start = max(0, i - window_size + 1)\n",
    "        window = X_arr[start:i + 1]\n",
    "        # Normalise by length so score is comparable across window sizes\n",
    "        scores[i] = hmm_model.score(window) / len(window)\n",
    "\n",
    "    return scores\n",
    "\n",
    "print(\"Scoring training samples...\")\n",
    "train_hmm_scores = score_with_temporal_windows(X_train_scaled, hmm_model)\n",
    "\n",
    "print(\"Scoring test samples...\")\n",
    "test_hmm_scores = score_with_temporal_windows(X_test_scaled, hmm_model)\n",
    "\n",
    "# Append sequential anomaly scores as the final hybrid column\n",
    "X_train_hybrid = np.column_stack((X_train_scaled, train_hmm_scores))\n",
    "X_test_hybrid  = np.column_stack((X_test_scaled,  test_hmm_scores))\n",
    "\n",
    "print(f\"\\nHybrid Training Shape : {X_train_hybrid.shape}\")\n",
    "print(f\"Hybrid Testing Shape  : {X_test_hybrid.shape}\")\n",
    "print(f\"\\nHMM score range (train): [{train_hmm_scores.min():.2f}, {train_hmm_scores.max():.2f}]\")\n",
    "print(f\"HMM score range (test) : [{test_hmm_scores.min():.2f}, {test_hmm_scores.max():.2f}]\")"
